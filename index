<title>Rawal Singh | Resume</title>
<style>
:root{--navy:#14283f;--teal:#168a8a;--ink:#243345;--muted:#647184;--line:#dce4eb;--paper:#fff;--wash:#f3f7f9}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--wash);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:var(--ink);line-height:1.65}
a{color:inherit}
.topbar{position:sticky;top:0;z-index:5;background:rgba(20,40,63,.96);backdrop-filter:blur(10px);color:white}
.nav{max-width:1040px;margin:auto;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{font-weight:800;letter-spacing:.08em;font-size:.9rem}
.navlinks{display:flex;gap:18px;align-items:center}
.navlinks a{text-decoration:none;color:#e4edf5;font-size:.88rem}
.navlinks a:hover{color:#7ce0d7}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 15px;border-radius:9px;text-decoration:none;font-weight:700;font-size:.9rem;border:1px solid transparent;cursor:pointer;transition:transform .15s,background .15s}
.btn:hover{transform:translateY(-1px)}
.btn-primary{background:var(--teal);color:white}
.btn-outline{border-color:#cbd7e2;color:var(--navy);background:white}
.hero{background:linear-gradient(135deg,#14283f 0%,#1d4358 65%,#168a8a 140%);color:white;padding:72px 22px 64px}
.hero-inner{max-width:940px;margin:auto}
.eyebrow{font-size:.78rem;text-transform:uppercase;letter-spacing:.18em;color:#8de3dc;font-weight:800}
h1{font-size:clamp(2.5rem,7vw,4.6rem);line-height:1.04;letter-spacing:-.045em;margin:12px 0}
.hero p{max-width:680px;color:#d9e5ed;font-size:1.08rem;margin:16px 0 26px}
.contactline{display:flex;flex-wrap:wrap;gap:10px 22px;color:#e5edf3;font-size:.92rem;margin-top:22px}
.contactline a{text-decoration:none}
.contactline a:hover{text-decoration:underline}
main{max-width:940px;margin:-24px auto 54px;padding:0 22px;position:relative}
.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(240px,.85fr);gap:20px}
.card{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:25px;box-shadow:0 8px 28px rgba(20,40,63,.055);margin-bottom:20px}
.section-title{display:flex;align-items:center;gap:11px;margin:0 0 16px;color:var(--navy);font-size:1.05rem;letter-spacing:.07em;text-transform:uppercase}
.section-title:before{content:"";width:4px;height:21px;border-radius:5px;background:var(--teal)}
p{margin:0 0 10px}
.muted{color:var(--muted)}
.jobhead{display:flex;justify-content:space-between;gap:15px;align-items:flex-start}
.jobtitle{font-weight:800;color:var(--navy)}
.date{font-size:.78rem;font-weight:800;letter-spacing:.06em;color:var(--teal);white-space:nowrap}
.project-label{font-size:.9rem;color:var(--muted);margin-top:5px}
ul{padding-left:19px;margin:10px 0 0}
li{margin:6px 0}
.edu-item{padding:13px 0;border-bottom:1px solid var(--line)}
.edu-item:first-of-type{padding-top:0}
.edu-item:last-child{border-bottom:0;padding-bottom:0}
.edu-top{display:flex;justify-content:space-between;gap:12px}
.edu-name{font-weight:800;color:var(--navy)}
.pill{display:inline-block;background:#e7f4f3;color:#116c6b;padding:4px 9px;border-radius:99px;font-size:.76rem;font-weight:800;white-space:nowrap}
.skill-list{display:flex;flex-wrap:wrap;gap:8px}
.skill{padding:7px 10px;background:#f0f5f7;border:1px solid #e0e8ed;border-radius:8px;font-size:.84rem}
.project-box{background:linear-gradient(135deg,#eff8f7,#f7fafc);border:1px solid #d5e9e7;padding:17px;border-radius:12px}
.project-box strong{color:var(--navy)}
.side-note{font-size:.92rem}
.footer{text-align:center;color:var(--muted);font-size:.82rem;padding:0 20px 32px}
.smallprint{font-size:.78rem;color:var(--muted);margin-top:16px}
@media(max-width:760px){.navlinks{display:none}.hero{padding:52px 20px 55px}.layout{grid-template-columns:1fr}main{padding:0 14px}.card{padding:21px}.jobhead,.edu-top{flex-direction:column;gap:4px}.date{white-space:normal}.nav{padding:12px 16px}}
@media print{body{background:white;font-size:10pt}.topbar,.actions,.footer{display:none!important}.hero{padding:24px 0 22px;background:white!important;color:var(--navy)}.hero p,.contactline{color:var(--ink)}.eyebrow{color:var(--teal)}main{margin:0 auto;padding:0;max-width:none}.layout{grid-template-columns:1.5fr 1fr;gap:12px}.card{box-shadow:none;border:1px solid #dce4eb;padding:16px;margin-bottom:12px;break-inside:avoid}.hero-inner,main{max-width:100%}a{text-decoration:none}.btn{display:none}h1{font-size:30pt}.section-title{margin-bottom:10px}}
</style>
</head>
